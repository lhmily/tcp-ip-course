      "heading": "Focused TCP state machine",
      "payload": {
        "initial": "closed",
        "states": [
          {"id": "closed", "label": "CLOSED"},
          {"id": "listen", "label": "LISTEN"},
          {"id": "syn-sent", "label": "SYN_SENT"},
          {"id": "syn-received", "label": "SYN_RECEIVED"},
          {"id": "established", "label": "ESTABLISHED"},
          {"id": "fin-wait-1", "label": "FIN_WAIT_1"},
