    {
      "id": "tcp-state-reliability-safety",
      "type": "safety_boundary",
      "heading": "Safety and network boundaries",
      "payload": {
        "allowed": [
          "Caller-owned buffers with explicit capacities",
          "Overflow-safe alias checks and transactional mutation",
          "Deterministic in-process byte arrays"
        ],
        "excluded": [
          "External network access, raw packet capture, or elevated privileges",
          "Dynamic allocation or global mutable state",
          "A production TCP stack, congestion control, or the complete RFC state machine"
        ]
      },
