    {
      "id": "tcp-state-reliability-exercise-test",
      "type": "exercise_test_contract",
      "heading": "Exercise and test contract",
      "payload": {
        "exercise": "Implement the transition table and two-phase fixed-window reassembly operations in exercise.c without allocation or partial commits.",
        "reference": "Use solution.c only after reasoning through the public contract and invariants.",
        "checks": [
          "All documented transitions and rejection of every other valid state/event pair",
          "Out-of-order insertion and uint32_t sequence wrap-around",
          "Duplicate idempotence and conflicting-overlap rollback",
          "Capacity and truncation rollback",
          "Zero-capacity, overlap, alias, and initialized-output behavior"
        ]
      },
