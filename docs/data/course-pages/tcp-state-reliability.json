          {"id": "app-close", "label": "Application close"},
          {"id": "receive-fin", "label": "Receive FIN"},
          {"id": "receive-fin-ack", "label": "Receive FIN+ACK"},
          {"id": "timeout", "label": "Timeout"}
        ],
        "transitions": [
          {"from": "closed", "event": "passive-open", "to": "listen"},
          {"from": "closed", "event": "active-open", "to": "syn-sent"},
          {"from": "listen", "event": "receive-syn", "to": "syn-received"},
          {"from": "listen", "event": "app-close", "to": "closed"},
          {"from": "syn-sent", "event": "receive-syn", "to": "syn-received"},
          {"from": "syn-sent", "event": "receive-syn-ack", "to": "established"},
          {"from": "syn-received", "event": "receive-ack", "to": "established"},
          {"from": "established", "event": "app-close", "to": "fin-wait-1"},
          {"from": "established", "event": "receive-fin", "to": "close-wait"},
          {"from": "fin-wait-1", "event": "receive-ack", "to": "fin-wait-2"},
          {"from": "fin-wait-1", "event": "receive-fin-ack", "to": "time-wait"},
          {"from": "fin-wait-2", "event": "receive-fin", "to": "time-wait"},
          {"from": "close-wait", "event": "app-close", "to": "last-ack"},
          {"from": "last-ack", "event": "receive-ack", "to": "closed"},
          {"from": "time-wait", "event": "timeout", "to": "closed"}
        ]
