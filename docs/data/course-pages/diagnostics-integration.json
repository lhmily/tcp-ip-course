      "type": "exercise_test_contract",
      "heading": "Exercise and test contract",
      "payload": {
        "exercise": "Implement the narrowing Ethernet-to-application diagnostic pipeline and queryable-capacity report formatting in exercise.c.",
        "reference": "Use solution.c after implementing the partial-report and diagnostic/status distinctions from lesson.h.",
        "checks": [
          "Ethernet to ARP, IPv4/ICMP, IPv4/UDP/DNS, and IPv4/TCP/HTTP paths",
          "Checksum-valid fixture construction and checksum-mismatch observation",
          "Truncated, malformed, and unsupported inputs",
          "Exact deterministic summary output",
          "NUL termination for short buffers and bounded ordered layer reporting"
        ]
      },
