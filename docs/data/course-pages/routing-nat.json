    {
      "id": "routing-nat-expiry-table",
      "type": "nat_table",
      "heading": "NAT expiry fixture",
      "payload": {
        "public_ip": "192.0.2.90",
        "first_port": 50000,
        "steps": [
          {
            "action": "init",
            "input": "capacity=2 first_port=50000 public_ip=192.0.2.90",
            "output": "storage[0..1] active=0",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "outbound first allocation",
            "input": "t=100 TCP 10.8.0.2:3000 -> 203.0.113.1:80",
            "output": "192.0.2.90:50000 -> 203.0.113.1:80",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "outbound second allocation",
            "input": "t=105 TCP 10.8.0.2:3001 -> 203.0.113.2:80",
            "output": "192.0.2.90:50001 -> 203.0.113.2:80",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "expire before threshold",
            "input": "now=109 idle=10",
            "output": "0 expired; both mappings stay active",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "expire at threshold",
            "input": "now=110 idle=10",
            "output": "1 expired; first inactive, second active",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "reuse after expiry",
            "input": "t=111 TCP 10.8.0.2:3000 -> 203.0.113.1:80",
            "output": "192.0.2.90:50000 -> 203.0.113.1:80",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "expire with backward time",
            "input": "now=100 idle=1 after reuse at 111",
            "output": "0 expired; backward time does not clear mapping",
            "status": "TCPIP_L11_OK"
          }
        ]
      },
      "provenance": [
        {
          "path": "lessons/11_routing_nat/test.c",
          "symbol": "tcpip_l11_test_expiry_and_reuse"
        }
      ]
