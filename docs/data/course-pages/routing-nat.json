    {
      "id": "routing-nat-mapping-table",
      "type": "nat_table",
      "heading": "NAT mapping fixture",
      "payload": {
        "public_ip": "198.51.100.9",
        "first_port": 40000,
        "steps": [
          {
            "action": "init",
            "input": "capacity=4 first_port=40000 public_ip=198.51.100.9",
            "output": "storage[0..3] active=0",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "outbound allocate",
            "input": "t=10 TCP 10.0.0.2:51000 -> 203.0.113.10:443",
            "output": "198.51.100.9:40000 -> 203.0.113.10:443; storage[0] active last_used=10",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "outbound reuse with alias",
            "input": "t=20 same TCP tuple, tuple == out",
            "output": "reuse public port 40000; storage[0] last_used=20; storage[1] inactive",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "outbound stale timestamp reuse",
            "input": "t=15 same TCP tuple after last_used=20",
            "output": "reuse public port 40000 without moving last_used backward",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "outbound second flow",
            "input": "t=21 UDP 10.0.0.3:51000 -> 203.0.113.11:53",
            "output": "198.51.100.9:40001 -> 203.0.113.11:53; public ports remain unique",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "outbound endpoint-dependent flow",
            "input": "t=22 TCP 10.0.0.2:51000 -> 203.0.113.11:443",
            "output": "198.51.100.9:40002 -> 203.0.113.11:443",
            "status": "TCPIP_L11_OK"
          }
        ]
      },
      "provenance": [
        {
          "path": "lessons/11_routing_nat/test.c",
          "symbol": "tcpip_l11_test_outbound_reuse_and_collision"
        }
      ]
    },
    {
      "id": "routing-nat-reverse-table",
      "type": "nat_table",
      "heading": "NAT inbound fixture",
      "payload": {
        "public_ip": "198.51.100.20",
        "first_port": 45000,
        "steps": [
          {
            "action": "init",
            "input": "capacity=2 first_port=45000 public_ip=198.51.100.20",
            "output": "storage[0..1] active=0",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "inbound before mapping",
            "input": "t=1 TCP 203.0.113.80:443 -> 198.51.100.20:45000",
            "output": "zero translated tuple; storage[0] inactive",
            "status": "TCPIP_L11_TRUNCATED"
          },
          {
            "action": "outbound creates reverse mapping",
            "input": "t=2 TCP 10.4.0.7:52000 -> 203.0.113.80:443",
            "output": "198.51.100.20:45000 -> 203.0.113.80:443",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "inbound reverse hit",
            "input": "t=3 TCP 203.0.113.80:443 -> 198.51.100.20:45000",
            "output": "203.0.113.80:443 -> 10.4.0.7:52000; storage[0] last_used=3",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "inbound stale timestamp hit",
            "input": "t=1 TCP 203.0.113.80:443 -> 198.51.100.20:45000 after last_used=3",
            "output": "reverse translation succeeds; storage[0] last_used stays 3",
            "status": "TCPIP_L11_OK"
          },
          {
            "action": "inbound stranger miss",
            "input": "t=4 TCP 203.0.113.81:443 -> 198.51.100.20:45000",
            "output": "zero translated tuple; storage[0] last_used stays 3",
            "status": "TCPIP_L11_TRUNCATED"
          }
        ]
      },
      "provenance": [
